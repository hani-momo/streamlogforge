{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["timestamp", "level", "service", "message", "tenant_id"],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "level": {
      "type": "string",
      "enum": ["DEBUG", "INFO", "WARN", "ERROR"]
    },
    "service": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "trace_id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    }
  }
}
